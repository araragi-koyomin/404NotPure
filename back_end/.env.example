# Local backend -> MySQL exposed by docker-compose.yml
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=Tomato
DB_USER=root
DB_PASSWORD=replace_with_local_database_password

# DATA-001 only: this documents the variable name. The importer intentionally
# requires it in the current process; do not persist the real value in this file.
# The normal application does not read or require this variable.
TOMATOMALL_DEMO_PASSWORD=replace_with_local_demo_only_password

# Local backend -> Redis exposed only on the local machine
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Product detail Cache-Aside is enabled by default. PERF-001 may override this
# only inside its isolated Compose project to measure the database-only baseline.
PRODUCT_DETAIL_CACHE_ENABLED=true

# Keep false for normal startup. See docs/guides/local-environment.md.
FLYWAY_BASELINE_ON_MIGRATE=false

# Authentication: use a random value with at least 32 characters; never commit the real value.
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRATION_SECONDS=86400
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Alibaba Cloud OSS (use a dedicated RAM user, not the account owner AccessKey)
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=replace_with_ram_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=replace_with_ram_access_key_secret
ALIYUN_OSS_BUCKET_NAME=replace_with_bucket_name

# Alipay sandbox
ALIPAY_APP_ID=replace_with_sandbox_app_id
ALIPAY_SELLER_ID=replace_with_sandbox_merchant_pid
ALIPAY_APP_PRIVATE_KEY=replace_with_single_line_pkcs8_application_private_key
ALIPAY_ALIPAY_PUBLIC_KEY=replace_with_single_line_sandbox_alipay_public_key
ALIPAY_SERVER_URL=replace_with_current_sandbox_gateway_from_console
ALIPAY_NOTIFY_URL=https://replace-with-public-backend.example/api/orders/notify
ALIPAY_RETURN_URL=https://replace-with-public-backend.example/api/orders/returnUrl
FRONTEND_URL=http://127.0.0.1:5173/?payment_success=true&orderId=
