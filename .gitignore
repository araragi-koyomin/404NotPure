# ========================================
# 通用忽略项（系统、编辑器、临时文件等）
# ========================================
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

*.swp
*.swo
*.tmp
*.bak
*.orig

# 日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========================================
# IDE 配置文件
# ========================================

# IntelliJ / WebStorm / PhpStorm / Android Studio
.idea/
*.iws
*.iml
*.ipr
out/

# VSCode
.vscode/

# Eclipse
.project
.classpath
.settings/
.loadpath

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ========================================
# 前端：Vite + Vue 项目
# ========================================
.vite/
/front_end/node_modules/
/front_end/dist/
/front_end/.vite/
/front_end/.env.local
/front_end/.env.*.local
/front_end/.output/
/front_end/.cache/

# 打包相关临时文件
/front_end/build/
/front_end/temp/

# Yarn / pnpm / bun lock 文件（你选用哪一个就删掉另外两个）
/front_end/yarn.lock
/front_end/pnpm-lock.yaml
/front_end/bun.lockb

# Mac/Linux 包管理缓存
.front_end/.npm/
.front_end/.yarn/

# ========================================
# 后端：Spring Boot + JPA 项目
# ========================================
/back_end/target/
back_end/.idea/
back_end/.classpath
back_end/.project
back_end/.settings/
/back_end/bin/
/back_end/out/

# Maven wrapper
/back_end/.mvn/
/back_end/mvnw
/back_end/mvnw.cmd

# Gradle（如你用它）
/back_end/.gradle/
/back_end/build/

# 环境配置
/back_end/.env
/back_end/*.env
/back_end/*.properties.local
/back_end/application-*.yml.local
/back_end/application-*.properties.local

# 数据库文件（如使用 H2 等内嵌数据库）
*.h2.db
*.mv.db
*.trace.db

# ========================================
# Git 本身
# ========================================
.git/
.gitignore
*.patch

# ========================================
# 可选：OS特定文件或开发工具
# ========================================

# Windows
$RECYCLE.BIN/
*.lnk

# Linux
*~

# macOS
.AppleDouble
.LSOverride
